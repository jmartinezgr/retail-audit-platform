APP_NAME=AuditLake
DEBUG=true

# Local: MinIO por HTTP (docker-compose). En prod contra Cloudflare R2:
# MINIO_ENDPOINT=<account_id>.r2.cloudflarestorage.com (sin esquema),
# MINIO_SECURE=true, MINIO_REGION=auto.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=admin123
MINIO_BUCKET=uploads
MINIO_SECURE=false
MINIO_REGION=us-east-1
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/auditlake
