APP_NAME=AuditLake
DEBUG=true

# S3-compatible storage. Local: MinIO por HTTP (docker-compose). En prod
# contra Cloudflare R2: S3_ENDPOINT=<account_id>.r2.cloudflarestorage.com
# (sin esquema), S3_SECURE=true, S3_REGION=auto.
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=admin
S3_SECRET_KEY=admin123
S3_BUCKET=uploads
S3_SECURE=false
S3_REGION=us-east-1
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/auditlake
