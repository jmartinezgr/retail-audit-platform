# Backend al que este agente le pega por HTTP - en producción se arma
# solo apuntando a 127.0.0.1:$PORT (ver settings.py), no hace falta
# tocarlo ahí.
BACKEND_BASE_URL=http://127.0.0.1:8000

# --- LLM: "ollama" (default, local, gratis) o "groq" (API gratuita
# hosteada, sin tarjeta - ver apps/agent/README.md, modelo verificado en
# vivo que soporta tool-calling) ---
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# --- Embeddings: "ollama" (default) o "gemini" (API gratuita de Google
# AI Studio, sin tarjeta) - independiente de LLM_PROVIDER ---
EMBED_PROVIDER=ollama
OLLAMA_EMBED_MODEL=nomic-embed-text
# GOOGLE_API_KEY=
GEMINI_EMBED_MODEL=gemini-embedding-001

# Fase 3 (RAG) - Qdrant corre aparte del docker-compose principal del
# proyecto. En producción, QDRANT_URL=":memory:" usa el modo embebido de
# qdrant-client (sin servidor, índice en RAM del propio proceso) - ver
# agent/rag/retrieve.py.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=auditlake_rules

MAX_STEPS=8
